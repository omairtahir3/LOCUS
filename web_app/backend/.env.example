# MongoDB â€” same DB as Python service
MONGO_URI=mongodb://localhost:27017/locusDB

# Server
PORT=5000
NODE_ENV=development

# JWT â€” use the SAME secret key as Python service so tokens work across both
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Email notifications (configure with your SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=LOCUS <your_email@gmail.com>

# Python AI service URL (for internal communication)
PYTHON_SERVICE_URL=http://localhost:8000

# LLM for notification phrasing and routine-finding messages (utils/llmClient.js).
# Free-tier status as of September 2026 (it changed in August; re-check):
#   groq        FREE, no card. 30 RPM, 14.4K req/day. Llama models are
#               enterprise-only now; free tier runs gpt-oss and Qwen.
#               https://console.groq.com
#   openrouter  FREE, no card. The free router picks an available free model.
#               https://openrouter.ai
#   cerebras    now requires a payment method ($5 credit, 30-day expiry). Optional.
# Leave LLM_PROVIDER unset (or 'none') to disable: every notification then uses
# its built-in template with zero added latency.
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_API_KEY=your_openrouter_api_key
LLM_FALLBACK_MODEL=openrouter/free