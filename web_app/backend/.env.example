# MongoDB — same DB as Python service
MONGO_URI=mongodb://localhost:27017/locusDB

# Server
PORT=5000
NODE_ENV=development

# JWT — use the SAME secret key as Python service so tokens work across both
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Email notifications (configure with your SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=LOCUS <your_email@gmail.com>

# Python AI service URL (for internal communication)
PYTHON_SERVICE_URL=http://localhost:8000

# LLM for notification phrasing and routine-finding messages (utils/llmClient.js).
# Both providers are OpenAI-compatible with free tiers far above Gemini's 10 RPM:
#   cerebras  30 RPM, 1M tokens/day   https://cloud.cerebras.ai
#   groq      30 RPM, 14.4K req/day   https://console.groq.com
# Leave LLM_PROVIDER unset (or 'none') to disable: every notification then uses
# its built-in template with zero added latency.
LLM_PROVIDER=cerebras
LLM_API_KEY=your_cerebras_api_key
LLM_MODEL=llama-3.3-70b
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_API_KEY=your_groq_api_key
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
